# Copy to .env and fill in the required values.
# Optional lines are commented out and show their default: uncomment only to change them.

# ---- Required ----
EMAIL='[ETS email account ending in @ens.etsmtl.ca]'
PASSWORD='[University Microsoft password]'
OPENAI_API_KEY='[OPENAI API KEY]'
DISCORD_BOT_TOKEN='[DISCORD BOT TOKEN]'
DISCORD_CHANNEL_ID=[DISCORD CHANNEL ID WHERE BOT WILL RELAY OFFERS]

# Starting session. Leave empty and the bot logs in on its first fetch.
# If set, use the full cookie string from see.etsmtl.ca:
# 'GASP2.WebEtudiant.Auth=...; ASP.NET_SessionId=...; NSC_...=...'
COOKIE=''

# ---- Optional features ----
# Resume as a JSON string. Enables GPT fit analysis and the quick apply button.
# CV_JSON='{"basics": {...}, "work": [...], "skills": [...]}'

# Cities you're willing to travel to, used in the fit analysis.
# RANGE='Montréal, Laval, Longueuil'

# Role to ping on each new offer (role ID, not a user ID).
# DISCORD_ROLE_ID=123456789012345678

# ---- Optional settings ----
# Seconds between checks of the job board.
# DELAY=600

# Where seen offers are recorded. Keep it under /data in Docker so it survives rebuilds.
# Without it, the bot uses postes.csv in the working directory.
POSTES_PATH=/data/postes.csv

# OATH label of your ETS account, used by every 2FA source (YubiKey, socket, 2fa keychain).
# ACCOUNT=ets

# Host socket path, only for the socket 2FA option.
# TOTP_SOCKET=/run/totp/totp.sock

# Where failure screenshots and page HTML are saved (last 10 kept).
# DEBUG_DIR=/data/debug
